{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "zmh-producer@zmhstudio": true,
    "zmh-3d@zmhstudio": true,
    "zmh-sky@zmhstudio": true,
    "zmh-synth@zmhstudio": true,
    "zmh-pixart@zmhstudio": true
  },
  "extraKnownMarketplaces": {
    "zmhstudio": {
      "source": {
        "source": "github",
        "repo": "ZackHelms/zmhstudio"
      }
    }
  }
}
